syntax = "proto3";

package simplenamingservice;

service SimpleNamingService {
	rpc Bind (BindMsg) returns (StatusReply) {}
	rpc Unbind (NameMsg) returns (StatusReply) {}
	rpc Rebind (BindMsg) returns (StatusReply) {}
	rpc Lookup (NameMsg) returns (LookupReply) {}
}

message BindMsg {
	string name = 1;
	string ipaddress = 2;
	string portnumber = 3;
}